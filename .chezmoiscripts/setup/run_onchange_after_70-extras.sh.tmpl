#!/bin/bash
{{ include ".chezmoitemplates/env.sh.tmpl" }}

# --- PERSONAL DATA (Notes) ---
{{- if eq .chezmoi.os "linux" }}
echo "📓 Syncing knowledge base..."
NOTES_DIR="$NK_DIR/notes"
if [ ! -d "$NOTES_DIR/.git" ]; then
    git clone "git@github.com:nkermani/notes.git" "$NOTES_DIR" || echo "  ⚠️  Notes clone failed. Check SSH keys."
fi
{{- end }}

# --- Scooter ---
if command -v cargo >/dev/null 2>&1; then
    echo "📚 Installing scooter..."
    if ! command -v scooter >/dev/null 2>&1; then
        cargo install scooter || echo "  ⚠️  scooter install failed"
    fi
fi

# --- BOOKOKRAT ---
{{- if .chezmoi.os }}
if command -v cargo >/dev/null 2>&1; then
    echo "📚 Installing bookokrat..."
    if ! command -v bookokrat >/dev/null 2>&1; then
        cargo install bookokrat || echo "  ⚠️  bookokrat install failed"
    fi
fi
{{- end }}

# --- OLLAMA ---
{{- if eq .chezmoi.os "linux" }}
echo "🤖 Setting up Ollama (Linux - sudoless)..."
if ! command -v ollama >/dev/null 2>&1; then
    export OLLAMA_INSTALL_PREFIX="$HOME/.local"
    export PATH="$HOME/.local/bin:$PATH"
    curl -fsSL https://ollama.ai/install.sh | sh || echo "  ⚠️  Ollama install failed"
fi
{{- end }}

{{- if eq .chezmoi.os "darwin" }}
echo "🤖 Setting up Ollama (macOS)..."
if ! command -v ollama >/dev/null 2>&1; then
    brew install ollama || echo "  ⚠️  Ollama install failed"
fi
{{- end }}

# Ensure ollama is in PATH for both OS
export PATH="$HOME/.local/bin:$PATH"

if command -v ollama >/dev/null 2>&1; then
    echo "📥 Pulling llama3.2:1b model..."
    ollama list 2>/dev/null | grep -q "llama3.2:1b" || ollama pull llama3.2:1b || echo "  ⚠️  Model pull failed"
fi
