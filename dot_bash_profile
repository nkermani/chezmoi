# ~/.bash_profile (login shell) - source ~/.profile and ~/.bashrc if available

# Detect OS
export UNAME_S="$(uname -s)"
export UNAME_M="$(uname -m)"
export DONT_PROMPT_WSL_INSTALL=1

if [ -f "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi

if [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi

# Nix (Linux 42 no-sudo - use nix-user-chroot for nix commands)
if [ "$UNAME_S" = "Linux" ] && [ -x "$HOME/nix-user-chroot" ]; then
  export nix_chroot="$HOME/nix-user-chroot $HOME/.nix"
fi