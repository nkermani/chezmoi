{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "#ad8c75",
    "bg": "#2a2827",
    "bgPanel": "#57514e",
    "bgPanelLight": "#f8f1e3",
    "bgElement": "#3c3836",
    "bgElementLight": "#ebdbb2",
    "fg": "#d4be98",
    "fgLight": "#3c3836",
    "muted": "#928374",
    "mutedLight": "#504945",
    "border": "#504945",
    "borderLight": "#bdae93",
    "accent": "#7da9a3",
    "error": "#ea6962",
    "warning": "#d8a657",
    "success": "#a9b665",
    "purple": "#d3869b",
    "green": "#89b482",
    "orange": "#e78a4e",
    "darkSteel": "#282828"
  },
  "theme": {
    "primary": { "dark": "primary", "light": "primary" },
    "secondary": { "dark": "accent", "light": "accent" },
    "accent": { "dark": "accent", "light": "accent" },
    "error": { "dark": "error", "light": "error" },
    "warning": { "dark": "warning", "light": "warning" },
    "success": { "dark": "success", "light": "success" },
    "info": { "dark": "accent", "light": "accent" },
    "text": { "dark": "fg", "light": "fgLight" },
    "textMuted": { "dark": "muted", "light": "mutedLight" },
    "textInverse": { "dark": "darkSteel", "light": "bgPanelLight" },
    "background": { "dark": "bg", "light": "bg" },
    "backgroundPanel": { "dark": "bgPanel", "light": "bgPanelLight" },
    "backgroundElement": { "dark": "bgElement", "light": "bgElementLight" },
    "border": { "dark": "border", "light": "borderLight" },
    "borderActive": { "dark": "accent", "light": "accent" },
    "borderSubtle": { "dark": "bgElement", "light": "bgElementLight" },
    "diffAdded": { "dark": "success", "light": "success" },
    "diffRemoved": { "dark": "error", "light": "error" },
    "diffContext": { "dark": "border", "light": "muted" },
    "diffHunkHeader": { "dark": "muted", "light": "muted" },
    "diffHighlightAdded": { "dark": "success", "light": "success" },
    "diffHighlightRemoved": { "dark": "error", "light": "error" },
    "diffAddedBg": { "dark": "darkSteel", "light": "bgElementLight" },
    "diffRemovedBg": { "dark": "darkSteel", "light": "bgElementLight" },
    "diffContextBg": { "dark": "darkSteel", "light": "bgElementLight" },
    "diffLineNumber": { "dark": "muted", "light": "muted" },
    "diffAddedLineNumberBg": { "dark": "darkSteel", "light": "bgElementLight" },
    "diffRemovedLineNumberBg": { "dark": "darkSteel", "light": "bgElementLight" },
    "markdownText": { "dark": "fg", "light": "mutedLight" },
    "markdownHeading": { "dark": "warning", "light": "warning" },
    "markdownLink": { "dark": "accent", "light": "accent" },
    "markdownLinkText": { "dark": "purple", "light": "purple" },
    "markdownCode": { "dark": "success", "light": "success" },
    "markdownBlockQuote": { "dark": "muted", "light": "muted" },
    "markdownEmph": { "dark": "warning", "light": "warning" },
    "markdownStrong": { "dark": "warning", "light": "warning" },
    "markdownHorizontalRule": { "dark": "mutedLight", "light": "muted" },
    "markdownListItem": { "dark": "accent", "light": "accent" },
    "markdownListEnumeration": { "dark": "accent", "light": "accent" },
    "markdownImage": { "dark": "accent", "light": "accent" },
    "markdownImageText": { "dark": "green", "light": "green" },
    "markdownCodeBlock": { "dark": "fg", "light": "fgLight" },
    "syntaxComment": { "dark": "muted", "light": "muted" },
    "syntaxKeyword": { "dark": "error", "light": "error" },
    "syntaxFunction": { "dark": "success", "light": "success" },
    "syntaxVariable": { "dark": "fg", "light": "fg" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "purple", "light": "purple" },
    "syntaxType": { "dark": "warning", "light": "warning" },
    "syntaxOperator": { "dark": "orange", "light": "orange" },
    "syntaxPunctuation": { "dark": "muted", "light": "mutedLight" }
  }
}
