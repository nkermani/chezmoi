{
  "$schema": "https://opencode.ai/config.json",
  // "plugin": [
  //   // "opencode-gemini-auth@latest"
  //   // "oh-my-openagent@latest" // disabled
  // ],
  "mode": {
    "plan": {
      "model": "opencode/minimax-m2.5-free",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  },
  "theme": "gruvbox-custom",
  "default_agent": "plan",
  "provider": {
    "google": {
      "options": {
        "projectId": "opencode-42",
        "timeout": 600000
      }
    }
  }
