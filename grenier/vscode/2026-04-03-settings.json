{
    //////////////////////////////////////////////////////////
    //                      NKERMANI                        
    //////////////////////////////////////////////////////////
    //                       General                        
    "files.autoSave": "afterDelay",
    //////////////////////////////////////////////////////////
    //                      AI-LESS                         
    "chat.disableAIFeatures": true,
    "chat.agent.enabled": false,
    "chat.tools.terminal.enableAutoApprove": false,
    "chat.tools.terminal.autoApprove": {
        "rm": false,
        "rmdir": false,
        "del": false,
        "kill": false,
        "curl": false,
        "wget": false,
        "eval": false,
        "chmod": false,
        "chown": false,
        "/^Remove-Item\\b/i": false,
        "docker compose": true,
        "docker run": true
    },
    "chat.autopilot.enabled": false,
    "chat.mcp.apps.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.mcp.gallery.enabled": false,
    //////////////////////////////////////////////////////////
    //                          Cursor
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    //////////////////////////////////////////////////////////
    //                       Terminal
    "terminal.integrated.copyOnSelection": true,
    //////////////////////////////////////////////////////////
    //                        THEME
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 14.5,
    "editor.fontWeight": "500",
    "terminal.integrated.fontSize": 14,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.colorTheme": "Bearded Theme Aquarelle Lilac",
    //////////////////////////////////////////////////////////
    //                      Explorer
    "explorer.confirmDelete": false,
    //////////////////////////////////////////////////////////
    //                       Editor                         
    "breadcrumbs.enabled": true,
    "workbench.editor.centeredLayoutAutoResize": true,
    "workbench.editor.centeredLayoutFixedWidth": true,
    
    //////////////////////////////////////////////////////////
    //                          UI
    
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "bottom",
    "workbench.browser.showInTitleBar": true,
    //////////////////////////////////////////////////////////
    "window.zoomLevel": 0, // if @42 on mac, else 2. 
    //////////////////////////////////////////////////////////
    //                          Minimap
    "editor.minimap.showSlider": "always",
    "editor.minimap.scale": 2,
    "errorLens.enabledDiagnosticLevels": [
        "warning",
        "info"
    ],
    

