
{
    "name": "NK Gruvbox Material Soft (Helix)",
    "type": "dark",
    "colors": {
        "editor.background": "#32302f",
        "editor.foreground": "#d4be98",

        "sideBar.background": "#2a2827",
        "sideBar.foreground": "#a89984",
        "sideBar.border": "#252423",
        "sideBarTitle.foreground": "#d4be98",
        "activityBar.background": "#252423",
        "activityBar.foreground": "#d4be98",
        "activityBar.inactiveForeground": "#7c6f64",
        "activityBar.border": "#252423",

        "editorGroupHeader.tabsBackground": "#2a2827",
        "tab.inactiveBackground": "#2a2827",
        "tab.activeBackground": "#32302f",
        "tab.border": "#252423",
        "tab.activeBorderTop": "#e78a4e",

        "panel.background": "#32302f",
        "terminal.background": "#2a2827",
        "statusBar.background": "#252423",
        "statusBar.foreground": "#a89984",

        "list.hoverBackground": "#3c3836",
        "list.activeSelectionBackground": "#45403d",
        "input.background": "#3c3836",

        "actionBar.toggledBackground": "#45403d",
        "activityBarBadge.background": "#a89984",
        "activityBarBadge.foreground": "#32302f",
        "button.background": "#bd6f3e",
        "button.foreground": "#32302f"
    },
    "tokenColors": [
        {
            "name": "FG_TEXT: Variables, Brackets, Parameters",
            "scope": [
                "variable",
                "variable.parameter",
                "punctuation.brackets",
                "punctuation.section",
                "meta.brace",
                "meta.parameters",
                "punctuation.definition.parameters",
                "punctuation.definition.arguments",
                "meta.function.definition.parameters",
                "meta.function-call.rust",
                "punctuation.section.group.rust",
                "punctuation.section.block.rust",
                "punctuation.section.brackets.rust"
            ],
            "settings": { "foreground": "#d4be98" }
        },
        {
            "name": "GREY_TECH: Technical punctuation, Comments",
            "scope": [
                "comment",
                "punctuation.terminator",
                "punctuation.separator",
                "keyword.operator.namespace",
                "punctuation.accessor",
                "storage.modifier.pointer",
                "punctuation.separator.namespace.rust"
            ],
            "settings": { "foreground": "#928374" }
        },
        {
            "name": "KEY_RED: Control keywords",
            "scope": [
                "keyword.control",
                "storage.type",
                "storage.modifier",
                "keyword.other.import"
            ],
            "settings": { "foreground": "#ea6962" }
        },
        {
            "name": "OP_ORANGE: Operators & Tags",
            "scope": [
                "keyword.operator",
                "entity.name.tag",
                "support.type.property-name.json"
            ],
            "settings": { "foreground": "#e78a4e" }
        },
        {
            "name": "TYPE_YELLOW: Types & Classes",
            "scope": [
                "entity.name.type",
                "entity.name.class",
                "entity.name.namespace",
                "support.type"
            ],
            "settings": { "foreground": "#d8a657" }
        },
        {
            "name": "FUNC_GREEN: Functions & Macros",
            "scope": [
                "entity.name.function",
                "support.function",
                "entity.name.function.macro"
            ],
            "settings": { "foreground": "#a9b665" }
        },
        {
            "name": "STR_AQUA: Strings",
            "scope": [
                "string",
                "string.quoted",
                "punctuation.definition.string",
                "string.quoted.double.json",
                "string.quoted.single.json"
            ],
            "settings": { "foreground": "#89b482" }
        },
        {
            "name": "NUM_PURPLE: Numbers & Constants",
            "scope": [
                "constant.numeric",
                "constant.language",
                "variable.language.this",
                "variable.language.self"
            ],
            "settings": { "foreground": "#d3869b" }
        }
    ],
    "semanticHighlighting": true,
    "semanticTokenColors": {
        "bracket": "#d4be98",
        "*.bracket": "#d4be98",
        "parameter": "#d4be98",
        "variable": "#d4be98",
        "punctuation": "#928374",
        "operator": "#e78a4e",
        "keyword": "#ea6962",
        "function": "#a9b665",
        "macro": "#a9b665",
        "type": "#d8a657",
        "class": "#d8a657",
        "string": "#89b482",
        "number": "#d3869b",
        "boolean": "#d3869b"
    }
}
