{
    //////////////////////////////////////////////////////////
    //                      NKERMANI
    //////////////////////////////////////////////////////////
    //                       General
    "files.autoSave": "afterDelay",
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "files.trimFinalNewlines": true,
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 100,
    "files.saveConflictResolution": "overwriteFileOnDisk",
    "window.confirmBeforeClose": "keyboardOnly",
    //////////////////////////////////////////////////////////
    //                      AI - ㅗ_(ㅇㅅㅇ)_ㅗ
    "chat.disableAIFeatures": true,
    "chat.agent.enabled": false,
    "chat.tools.terminal.enableAutoApprove": false,
    "chat.tools.terminal.autoApprove": {
        "rm": false,
        "rmdir": false,
        "del": false,
        "kill": false,
        "curl": false,
        "wget": false,
        "eval": false,
        "chmod": false,
        "chown": false,
        "/^Remove-Item\\b/i": false,
        "docker compose": true,
        "docker run": true
    },
    "chat.autopilot.enabled": false,
    "chat.mcp.apps.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "github.copilot.nextEditSuggestions.enabled": false,
    "chat.mcp.gallery.enabled": false,
    "terminal.integrated.initialHint": false,
    //////////////////////////////////////////////////////////
    //                          Cursor
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    //////////////////////////////////////////////////////////
    //                       Terminal
    "terminal.integrated.copyOnSelection": true,
    //////////////////////////////////////////////////////////
    //                      Explorer
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    //////////////////////////////////////////////////////////
    //                       Editor
    "breadcrumbs.enabled": true,
    "workbench.editor.centeredLayoutAutoResize": true,
    "workbench.editor.centeredLayoutFixedWidth": true,
    "editor.inlayHints.enabled": "offUnlessPressed",
    "editor.suggest.showMethods": true,
    "editor.suggest.showDetails": true,
    "editor.suggest.showFunctions": true,
    "editor.suggest.preview": true,
    "editor.hover.delay": 300, // Time in ms before the hover popup appears
    "editor.suggestSelection": "first",
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.hover.enabled": "on",
    //////////////////////////////////////////////////////////
    //                          UI
    "window.closeWhenEmpty": false,
    "workbench.activityBar.compact": true,
    "workbench.activityBar.location": "bottom",
    "workbench.browser.showInTitleBar": true,
    "workbench.sideBar.location": "left",
    "editor.showFoldingControls": "always",
    "editor.foldingStrategy": "indentation",
    "[rust]": {
        "editor.foldingStrategy": "indentation",
    },
    "window.zoomLevel": 0,
    "editor.minimap.showSlider": "always",
    "editor.minimap.scale": 1,
    "errorLens.enabledDiagnosticLevels": [
        "info",
        "error",
        "warning"
    ],
    //////////////////////////////////////////////////////////
    //                         Git
    "git.openRepositoryInParentFolders": "never",
    "workbench.startupEditor": "none",
    "errorLens.enabled": false,
    "telemetry.feedback.enabled": false,
    "terminal.integrated.commandsToSkipShell": [
        "kilo-code.new.agentManagerOpen",
        "kilo-code.new.agentManager.showTerminal"
    ],
    "editor.quickSuggestions": {

        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "errorLens.respectUpstreamEnabled": {
        "statusBar": true
    },
    //////////////////////////////////////////////////////////
    //                        THEME
    "editor.fontFamily": "JetBrainsMono Nerd Font",
    "editor.fontSize": 14.5,
    "editor.cursorWidth": 3,
    "editor.fontWeight": "500",
    "terminal.integrated.fontSize": 14,
    "workbench.iconTheme": "material-icon-theme",
    "editor.bracketPairColorization.enabled": false,
    "workbench.colorTheme": "Gruvbox Material Flat Dark",
    // OVERRIDE
    "markdown.preview.breaks": true,
    "workbench.colorCustomizations": {
        "[Gruvbox Material Flat Dark]": {
            // --- Fond de l'éditeur (Ta base) ---
            "editor.background": "#32302f",
            "editor.foreground": "#d4be98",

            // --- Barre Latérale (Sidebar) : Plus sombre que l'éditeur ---
            "sideBar.background": "#2a2827",
            "sideBar.foreground": "#a89984",
            "sideBar.border": "#252423",
            "sideBarSectionHeader.background": "#32302f", // Rappel du fond éditeur pour les titres
            "sideBarTitle.foreground": "#d4be98",

            // --- Barre d'Activité (L'extrême gauche) : Encore plus sombre ---
            "activityBar.background": "#252423",
            "activityBar.foreground": "#d4be98",
            "activityBar.inactiveForeground": "#7c6f64",
            "activityBar.border": "#252423",

            // --- Onglets (Tabs) : Séparation nette ---
            "editorGroupHeader.tabsBackground": "#2a2827",
            "tab.inactiveBackground": "#2a2827",
            "tab.activeBackground": "#32302f", // L'onglet actif se fond dans le code
            "tab.border": "#252423",
            "tab.activeBorderTop": "#e78a4e", // Petite ligne orange Helix pour l'onglet actif

            // --- Panneaux (Terminal, Output) ---
            "panel.background": "#32302f",
            "panel.border": "#252423",

            // --- Barre de statut (Tout en bas) ---
            "statusBar.background": "#252423",
            "statusBar.foreground": "#a89984",
            "statusBar.border": "#252423",

            // --- Liste & Menus ---
            "list.hoverBackground": "#3c3836",
            "list.activeSelectionBackground": "#45403d",

            // --- Terminal
            "terminal.background": "#2a2827",
            // --- SYNTAXE DANS LA PREVIEW MARKDOWN ---
            // Pour le texte entre `backticks` (inline code)
            "textPreformat.foreground": "#d8a657", // Jaune (comme tes types)
            "textPreformat.background": "#3c3836", // Fond discret

            // Pour les blocs ``` code ```
            "textCodeBlock.background": "#2a2827", // Fond sombre type Sidebar
            // Liens et citations
            "textLink.foreground": "#89b482",
            "textBlockQuote.background": "#2a2827",
            "textBlockQuote.border": "#ea6962"
        }
    },

    "editor.tokenColorCustomizations": {
        "[Gruvbox Material Flat Dark]": {
            "textMateRules": [
                {
                    "name": "FG_TEXT: Force Brackets & Parenthesis to FG0",
                    "scope": [
                        "variable",
                        "variable.parameter",
                        "punctuation.brackets",
                        "punctuation.section",
                        "meta.brace",
                        "meta.parameters",
                        "punctuation.definition.parameters", // Les parenthèses de fn main()
                        "punctuation.definition.arguments",  // Les parenthèses de println!()
                        "meta.parameters punctuation.definition.parameters",
                        "meta.function.definition.parameters",
                        "meta.function-call.rust",
                        "punctuation.brackets.rust",
                        "punctuation.section.group.rust",
                        "punctuation.section.brackets.rust",
                        "punctuation.section.block.rust",
                        "punctuation.section.generic.rust",
                        "punctuation.section.macro.rust",
                        "meta.bracket.rust",
                        "punctuation.definition.lifetime.rust",
                        "entity.name.type.lifetime.rust"
                    ],
                    "settings": {
                        "foreground": "#d4be98"
                    }
                },
                {
                    "name": "GREY_TECH: Force Double Colon & Semicolon",
                    "scope": [
                        "punctuation.separator.namespace.rust", // Le ::
                        "punctuation.terminator.rust",       // Le ;
                        "keyword.operator.key-value.rust",
                        "keyword.operator.namespace.rust",
                    ],
                    "settings": {
                        "foreground": "#928374"
                    }
                },
                {
                    "name": "GREY_TECH: Technical punctuation, Comments",
                    "scope": [
                        "comment",
                        "punctuation.terminator",
                        "punctuation.separator",
                        "keyword.operator.namespace",
                        "punctuation.separator.namespace.rust", // Le ::
                        "punctuation.terminator.rust",           // Le ;
                        "punctuation.accessor",
                        "storage.modifier.pointer",
                        "keyword.operator.access.dot.rust",

                    ],
                    "settings": { "foreground": "#928374" }
                },
                {
                    "name": "KEY_RED: Control keywords",
                    "scope": [
                        "keyword.control",
                        "storage.type",
                        "storage.modifier",
                        "keyword.other.import",
                        "storage.modifier.mut.rust"
                    ],
                    "settings": { "foreground": "#ea6962" }
                },
                {
                    "name": "OP_ORANGE: Operators & Tags",
                    "scope": [
                        "keyword.operator",
                        "entity.name.tag"
                    ],
                    "settings": { "foreground": "#e78a4e" }
                },
                {
                    "name": "BLUE",
                    "scope": [
                        "variable.other.property",
                        "punctuation.definition.interpolation.rust",
                        "punctuation.section.embedded.rust",
                    ],
                    "settings": { "foreground": "#7daea3" }
                },
                {
                    "name": "TYPE_YELLOW: Types & Classes",
                    "scope": [
                        "entity.name.type",
                        "entity.name.class",
                        "entity.name.namespace",
                        "support.type"
                    ],
                    "settings": { "foreground": "#d8a657" }
                },
                {
                    "name": "FUNC_GREEN: Functions & Macros",
                    "scope": [
                        "entity.name.function",
                        "support.function",
                        "entity.name.function.macro"
                    ],
                    "settings": { "foreground": "#a9b665" }
                },
                {
                    "name": "NUM_PURPLE: Numbers & Constants",
                    "scope": [
                        "constant.numeric",
                        "constant.language",
                        "variable.language.this",
                        "variable.language.self",
                        "variable.language.self.rust",
                        "variable.other.enummember",
                    ],
                    "settings": { "foreground": "#d3869b" }
                },
                {
                    "name": "STR_AQUA: Strings (Universal & JSON values)",
                    "scope": [
                        "string",
                        "string.quoted",
                        "string.quoted.double",
                        "string.quoted.single",
                        "punctuation.definition.string",
                        "string.quoted.double.json",
                        "string.quoted.single.json"
                    ],
                    "settings": { "foreground": "#89b482" }
                },
                {
                    "name": "RUST_SELF_FORCE: Purple Self",
                    "scope": [
                        "variable.language.self.rust",
                        "variable.parameter.variable-language.rust",
                        "keyword.other.self.rust"
                    ],
                    "settings": {
                        "foreground": "#d3869b",
                        "fontStyle": ""
                    }
                },
                {
                    "name": "Markdown Syntax Highlighting Match",
                    "scope": [
                        "markup.inline.raw",
                        "markup.fenced_code.block",
                        "variable.language.fenced.markdown"
                    ],
                    "settings": {
                        "foreground": "#d4be98"
                    }
                },
            ]
        },
    },
    "editor.semanticTokenColorCustomizations": {
        "[Gruvbox Material Flat Dark]": {
            "enabled": true,
            "rules": {
                "selfKeyword": "#d3869b",
                "selfParameter": "#d3869b",
                "variable.language": "#d3869b",
                "variable.readonly.defaultLibrary": "#d3869b",
                //
                "punctuation.bracket": "#d4be98",
                "*.bracket": "#d4be98",
                "bracket": "#d4be98",     // FG_TEXT
                "variable": "#d4be98",    // FG_TEXT
                "parameter": "#d4be98",   // FG_TEXT
                "punctuation": "#928374", // GREY_TECH
                "operator.punctuation": "#928374",
                "operator": "#e78a4e",    // OP_ORANGE
                "keyword": "#ea6962",     // KEY_RED
                "function": "#a9b665",    // FUNC_GREEN
                "macro": "#a9b665",       // FUNC_GREEN
                "type": "#d8a657",        // TYPE_YELLOW
                "class": "#d8a657",       // TYPE_YELLOW
                "string": "#89b482",      // STR_AQUA
                "number": "#d3869b",       // NUM_PURPLE
                // --- Palette Markdown Preview ---
                "markdown.preview.background": "#32302f",      // Fond principal
                "markdown.preview.foreground": "#d4be98",      // Texte (FG_TEXT)

                // Titres (Headers) - On utilise le Jaune/Orange pour le relief
                "notificationLink.foreground": "#d8a657",
                "textLink.foreground": "#89b482",              // Liens en Aqua (Strings)
                "textLink.activeForeground": "#a9b665",

                // Blocs de code (Code Spans & Blocks)
                "textCodeBlock.background": "#2a2827",         // Un ton plus sombre pour le relief
                "textPreformat.foreground": "#d8a657",         // Inline code en Jaune (Types)
                "textPreformat.background": "#3c3836",

                // Citations (Blockquotes)
                "textBlockQuote.background": "#2a2827",
                "textBlockQuote.border": "#ea6962",            // Bordure en Rouge (Keywords)

                // Séparateurs (HR)
                "textSeparator.foreground": "#928374"          // Gris technique
            }
        }
    },

    // giof.insertfilenameascomment
    "insertFilename.usePath": true,
    "insertFilename.fileExtensions": [
        ".js", ".ts", ".py", ".cpp",
        ".rs", ".c", ".h", ".sh", ".md", ".yaml", ".yml", ".go"
    ],
    "insertFilename.commentStyleMap": {
        ".rs": "//",
        ".c": "//",
        ".h": "//",
        ".sh": "#",
        ".md": "",
        ".yaml": "#",
        ".yml": "#",
        ".go": "//",
        ".py": "#"
    },

    "indentRainbow.colors": [
        "rgba(168, 153, 132, 0.04)", // Sand / Cream (Neutre)
        "rgba(142, 192, 124, 0.04)", // Aqua délavé
        "rgba(211, 174, 126, 0.04)", // Terra Cotta clair
        "rgba(131, 165, 152, 0.04)", // Bleu ardoise doux
        "rgba(189, 174, 147, 0.04)", // Gris chaud
        "rgba(214, 147, 131, 0.04)"  // Rose poussiéreux
    ],
    "indentRainbow.errorColor": "rgba(234, 105, 98, 0.2)",
    "zenMode.showTabs": "none",
