{ config, pkgs, ... }:

{
  imports = [
    ./modules/home.nix
    ./modules/packages.nix
    ./modules/shell-aliases.nix
    ./modules/programs/bat.nix
    ./modules/programs/bash.nix
    ./modules/programs/btop.nix
    {{- if and (eq .chezmoi.os "linux") (not (contains "microsoft" .chezmoi.kernel.osrelease)) }}
    ./modules/programs/code.nix
    {{- end }}
    ./modules/programs/eza.nix
    ./modules/programs/fish.nix
    ./modules/programs/git.nix
    ./modules/programs/helix.nix
    ./modules/programs/lazygit.nix
    ./modules/programs/yazi.nix
    ./modules/programs/zsh.nix
  ];

  # Let Home Manager install and manage itself.
  programs.home-manager.enable = true;

  # Nix Garbage Collection - Linux (systemd)
  # Disabled: no user systemd session available (e.g., 42 School)
  {{- if and (eq .chezmoi.os "linux") (contains "microsoft" .chezmoi.kernel.osrelease) }}
    systemd.user.services.nix-gc = {
      Unit = {
        Description = "Nix Garbage Collection";
        After = [ "network.target" ];
      };
      Service = {
        Type = "oneshot";
        ExecStart = "${pkgs.nix}/bin/nix-collect-garbage --delete-older-than 30d && ${pkgs.nix}/bin/nix-store --optimise";
        Nice = 10;
        IOSchedulingClass = "idle";
      };
    };
    systemd.user.timers.nix-gc = {
      Unit = { Description = "Weekly Nix Garbage Collection"; };
      Timer = {
        OnCalendar = "weekly";
        Persistent = true;
        RandomizedDelaySec = "1h";
      };
      Install = { WantedBy = [ "timers.target" ]; };
    };
  {{- end }}

  # Nix Garbage Collection - macOS (launchd)
  {{- if eq .chezmoi.os "darwin" }}
  home.file.".local/bin/nix-gc" = {
    text = ''
      #!/bin/sh
      ${pkgs.nix}/bin/nix-collect-garbage --delete-older-than 30d
      ${pkgs.nix}/bin/nix-store --optimise
    '';
    executable = true;
  };

  launchd.agents.nix-gc = {
    enable = true;
    config = {
      Label = "org.nix.gc";
      ProgramArguments = [ "{{ .chezmoi.homeDir }}/.local/bin/nix-gc" ];
      StartInterval = 604800;
      RunAtLoad = false;
    };
  };
  {{- end }}
}
