{ pkgs, ... }:

let
  {{ if eq .chezmoi.os "linux" -}}
  nvr-open = pkgs.writeShellScriptBin "nvr-open" ''
    FILE="$1"
    if [ -S /tmp/nvimsocket ] && nvr --servername /tmp/nvimsocket --remote-expr '1+1' &>/dev/null; then
      nvr --remote-silent "$FILE"
    elif command -v wt.exe &>/dev/null; then
      wt.exe nvim --listen /tmp/nvimsocket "$FILE"
    else
      kitty nvim --listen /tmp/nvimsocket "$FILE"
    fi
  '';
  {{ end -}}

  lapce-wrapped = pkgs.symlinkJoin {
    name = "lapce";
    paths = [ pkgs.lapce ];
    nativeBuildInputs = [ pkgs.makeWrapper ];
    postBuild = ''
      wrapProgram $out/bin/lapce \
        --prefix LD_LIBRARY_PATH : ${pkgs.lib.makeLibraryPath [ pkgs.libdrm pkgs.mesa pkgs.vulkan-loader ]}
    '';
  };
in

{
  nixpkgs.config.allowUnfree = true;

  home.packages = [
    # Runtimes
    pkgs.devenv # Manages all projects runtime requirements via devenv.nix
    pkgs.python3
    pkgs.python3Packages.pip
    pkgs.nodejs_22
    pkgs.rustc
    pkgs.cargo
    pkgs.bun

    # LSP Servers
    pkgs.clang-tools # C/C++ (clangd)
    pkgs.csharp-ls # C#
    pkgs.basedpyright # Python (pyright fork)
    pkgs.python3Packages.python-lsp-server # Python (pylsp)
    pkgs.rust-analyzer # Rust
    pkgs.typescript-language-server # TypeScript / JavaScript
    pkgs.gopls # Go
    pkgs.nixd # Nix
    pkgs.zls # Zig
    pkgs.neovim-remote # nvr: connect to running nvim
    {{ if eq .chezmoi.os "linux" -}}
    nvr-open # xdg-open handler: nvr or kitty nvim
    {{ end -}}
    pkgs.perlnavigator # Perl
    pkgs.phpactor # PHP

    # CLI Tools
    pkgs.fzf # fzf
    pkgs.ripgrep # rg
    pkgs.fd # fd
    pkgs.bat # bat > cat
    pkgs.lazygit # lg
    pkgs.tree # tree
    pkgs.eza # eza > ls
    pkgs.yazi # yazi
    pkgs.btop # btop > htop > top
    pkgs.duckdb # cli for data file previews
    pkgs.scooter # interactive find and replace TUI
    pkgs.tabiew # interactive csv/db viewer

    pkgs.lite-xl # GUI editor
    lapce-wrapped # zedlike (wrapped with GPU libs)
    pkgs.fresh-editor # TUI editor
    pkgs.opencode # opensource ai

    pkgs.bash # bash
    pkgs.zsh # zsh
    pkgs.fish # fish
    pkgs.nushell # nu
    pkgs.nerd-fonts.jetbrains-mono # font

    # Wayland compositor & shell
    pkgs.niri # scrollable-tiling Wayland compositor
    pkgs.noctalia-shell # desktop shell for Wayland
  ];
}
