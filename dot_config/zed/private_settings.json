//           (ㅇㅅㅇ) -- NKERMANI -- (ㅇㅅㅇ)
//////////////////////////////////////////////////////////
//         ㅗ_(ㅇㅅㅇ)_ㅗ - ai - ㅗ_(ㅇㅅㅇ)_ㅗ
//////////////////////////////////////////////////////////
{
  "disable_ai": true,
  "base_keymap": "VSCode",
  "helix_mode": false,
  "vim_mode": false,
  "cli_default_open_behavior": "new_window",
  "when_closing_with_no_tabs": "platform_default",
  "autosave":"on_focus_change",
  "format_on_save": "off",
  "show_wrap_guides": true,
  "soft_wrap":"bounded",
  "wrap_guides": [80],
  //////////////////////////////////////////////////////////
  //                       search
  //////////////////////////////////////////////////////////
  "search": {
    "button": true
  },
  //////////////////////////////////////////////////////////
  //                       proxy
  //////////////////////////////////////////////////////////
  "proxy": "",
  "calls": {
    "mute_on_join": true
  },
  //////////////////////////////////////////////////////////
  //                       git
  //////////////////////////////////////////////////////////
  "git": {
    "branch_picker": {
      "show_author_name": false
    },
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "enabled": false
    },
    "disable_git": false
  },
  //////////////////////////////////////////////////////////
  //                       terminal
  //////////////////////////////////////////////////////////
  "centered_layout": null,
  "terminal": {
    "flexible": false,
    "dock": "bottom",
    "button": true,
    "copy_on_select": true,
    "font_weight": 600.0,
    "shell": {
      "program": "fish"
    }
  },
  //////////////////////////////////////////////////////////
  //                       agent
  //////////////////////////////////////////////////////////
  "agent": {
    "sidebar_side": "right",
    "show_merge_conflict_indicator": true,
    "expand_terminal_card": false,
    "expand_edit_card": false,
    "enable_feedback": false,
    "flexible": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  //////////////////////////////////////////////////////////
  //                       collaboration
  //////////////////////////////////////////////////////////
  "collaboration_panel": {
    "button": false
  },
  //////////////////////////////////////////////////////////
  //                          UI
  //////////////////////////////////////////////////////////
  "cursor_shape":"block",
  "cursor_blink": true,
  "git_panel": {
    "file_icons": true,
    "tree_view": true,
    "button": true
  },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0
  },
  "diagnostics_max_severity": "all",
  "bottom_dock_layout": "contained",
  "tabs": {
    "show_diagnostics":"errors",
    "show_close_button": "hidden",
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_branch_name": true,
    "show_branch_status_icon": true
  },
  "debugger": {
    "button": true
  },
  "diagnostics": {
    "button": true,
    "inline":{
        "enabled": false,
        "max_severity": null,
    }
  },
  "status_bar": {
    "cursor_position_button": true,
    "show_active_file": true,
    "active_language_button": true
  },

  "project_panel": {
    "show_diagnostics":"errors",
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "indent_size": 18.0,
    "entry_spacing": "standard",
    "hide_gitignore": true,
    "button": true,
    "dock": "left",
  },
  "message_editor": {
    "auto_replace_emoji_shortcode": false
  },
  "middle_click_paste": false,
  "code_lens": "menu",
  "inlay_hints": {
    "edit_debounce_ms": 700,
    "enabled": false
  },
  "show_whitespaces": "selection",
  "indent_guides": {
    "coloring": "fixed",
    "line_width": 2
  },
  //////////////////////////////////////////////////////////
  //                       vim
  //////////////////////////////////////////////////////////
  "vim": {
    "gdefault": true,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true,
  },
  //////////////////////////////////////////////////////////
  //                       toolbar
  //////////////////////////////////////////////////////////
  "toolbar": {
    "breadcrumbs": true,
    "selections_menu": false,
    "quick_actions": false,
    "agent_review": false,
  },
  //////////////////////////////////////////////////////////
  //                       minimap
  //////////////////////////////////////////////////////////
  // "minimap": {
  //   "show": "always"
  // },
  "inline_code_actions": false,
  "relative_line_numbers": "disabled",
  "gutter": {
    "folds": false,
    "bookmarks": false,
    "breakpoints": false,
    "runnables": false,
    "min_line_number_digits": 0
  },
  // Scrollbar
  "scrollbar": {
    "show": "always",
    "diagnostics": "all"
  },

  //////////////////////////////////////////////////////////
  //                       Theme && fonts
  //////////////////////////////////////////////////////////
  "ui_font_weight": 600.0,
  "ui_font_family": ".ZedSans",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_weight": 600.0,
  "buffer_line_height": "standard",
  "icon_theme": {
    "mode": "dark",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Frappé (Blur) [Heavy]",
    "dark": "Catppuccin Frappé (Blur) [Heavy]",
  },
  "theme_overrides": {
      "Cursor Dark":{
        "editor.background": "#252525",
        "editor.gutter.background": "#181818",
        "info.background": "#181818",
        "background": "#181818",
        "panel.background": "#191919",
      },
      "Seoul256 Dark":{
        "background.appearance": "opaque",
        "background": "#505050f7",
        "editor.background": "#50505040",
        "editor.gutter.background": "#505050ec",
        "status_bar.background": "#505050ec",
        "title_bar.background": "#505050f7",
        "tab.inactive_background": "#505050ec",

      },
      "Catppuccin Frappé (Blur) [Heavy]":{
        "players": [
          {
            "cursor": "#aadbc1dd"
          }
        ],
        "background.appearance": "opaque",
        "background": "#303446f5",
        "status_bar.background": "#303446f7",
        "title_bar.background": "#303446f7",
        "tab.inactive_background": "#303446ec",
      },
   },
   //////////////////////////////////////////////////////////
   //                         Resolution
   //////////////////////////////////////////////////////////
   // 4K
   //////////////////////////////////////////////////////////
   // "terminal.default_height" : 600,
   // "outline_panel.default_width":400,
   // "project_panel.default_width": 320,
   // "terminal.font_size": 18.0,
   // "ui_font_size": 18.0,
   // "buffer_font_size": 20.0,
   //////////////////////////////////////////////////////////
   // 1920x1080
   //////////////////////////////////////////////////////////
   "terminal.default_height" : 350,
   "outline_panel.default_width":400,
   "project_panel.default_width": 320,
   "terminal.font_size": 14.0,
   "ui_font_size": 14.0,
   "buffer_font_size": 15.0,
   //////////////////////////////////////////////////////////
}
