#!/bin/bash
# gcm - Version Turbo Locale (Strict Types)

# 1. Préparation du contexte court
diff_context=$(git diff --cached --stat ; git diff --cached | head -n 30)

if [[ -z "$diff_context" ]]; then
    echo "❌ Aucun changement indexé."
    exit 1
fi

echo "⚡ Génération..."

# 2. Appel Ollama avec une contrainte de début de phrase
# On demande explicitement de NE PAS commencer par "Here is" ou "Added"
raw_msg=$(ollama run llama3.2:1b "You are a git assistant. Write a 1-line conventional commit for this diff. 
TYPES: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
RULE: Start IMMEDIATELY with the type. No intro. No quotes.
Diff: $diff_context" 2>/dev/null | head -n 1)

# 3. NETTOYAGE STRICT (Le secret)
# On supprime tout ce qui précède le premier type valide rencontré
clean_msg=$(echo "$raw_msg" | sed -E 's/^.*(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/\1/' | tr -d '"`')

# 4. Validation finale
if [[ "$clean_msg" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert) ]]; then
    echo -e "\n📝 $clean_msg"
    git commit -m "$clean_msg"
else
    # Si l'IA a vraiment échoué, on force un type 'chore' sur son texte
    # pour éviter un commit sans format.
    final_fallback="chore: $(echo "$clean_msg" | sed 's/^[[:punct:][:space:]]*//')"
    echo -e "\n⚠️ Correction auto : $final_fallback"
    git commit -m "$final_fallback"
fi
