#!/bin/bash
# gcm - Generate commit message with AI (Optimized for Speed)

# Récupération légère du diff (max 100 lignes pour la vitesse)
full_diff=$(git diff --cached 2>/dev/null | head -n 100)

if [[ -z "$full_diff" ]]; then
    echo "No changes to commit (did you 'git add'?)"
    exit 1
fi

# Prompt minimaliste = Réponse plus rapide
prompt="Task: Git commit (Conventional Commits).
Rules: type(scope): description (max 50 chars), imperative.
Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
Output ONLY message.
Diff:
$full_diff"

# Appel OpenCode avec nettoyage des guillemets
msg=$(opencode run --model=opencode/minimax-m2.5-free --variant=minimal "$prompt" 2>/dev/null | tr -d '"')

if [[ -n "$msg" ]]; then
    echo -e "\nCommit: $msg"
    git commit -m "$msg"
else
    echo "Error: AI failed to respond"
    exit 1
fi
