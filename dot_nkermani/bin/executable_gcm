#!/bin/bash
# gcm - Version Ollama (Locale, Gratuite & Ultra-Rapide)

# 1. Récupérer le diff
full_diff=$(git diff --cached 2>/dev/null | head -n 50)

if [[ -z "$full_diff" ]]; then
    echo "❌ Aucun changement indexé."
    exit 1
fi

# 2. Appel local à Ollama (Llama 3.2 1B)
# On demande un message de commit direct sans fioritures
msg=$(ollama run llama3.2:1b "Write a conventional commit message (type(scope): description) for: $full_diff. Output ONLY the message, no quotes, no period." 2>/dev/null | tr -d '"')

if [[ -n "$msg" ]]; then
    echo -e "\n📝 Message (Ollama) : $msg"
    git commit -m "$msg"
else
    echo "❌ Erreur : Vérifiez que Ollama est bien lancé (ollama serve)."
    exit 1
fi
