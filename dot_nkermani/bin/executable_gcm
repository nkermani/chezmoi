#!/bin/bash
# gcm - Version Turbo Locale avec Respect Strict des Types

# 1. Préparation du contexte
diff_context=$(git diff --cached --stat ; git diff --cached | head -n 30)

if [[ -z "$diff_context" ]]; then
    echo "❌ Aucun changement indexé."
    exit 1
fi

echo "⚡ Génération..."

# 2. On sépare les types pour que l'IA ne puisse pas les rater
TYPES="feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"

# 3. Appel Ollama avec un prompt ultra-directif
# On force l'IA à commencer par un des types
msg=$(ollama run llama3.2:1b "You are a git bot. Use ONLY these types: $TYPES.
Format: type(scope): description.
Rules: No intro, no quotes, no period.
Diff: $diff_context" 2>/dev/null | head -n 1 | tr -d '"`')

# 4. Nettoyage de sécurité pour garantir le format "type: description"
# Cette ligne supprime tout ce qui précède le premier mot-clé valide s'il y a du blabla
clean_msg=$(echo "$msg" | sed -E "s/^.*(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/\1/")

if [[ -n "$clean_msg" && "$clean_msg" == *:* ]]; then
    echo -e "\n📝 $clean_msg"
    git commit -m "$clean_msg"
else
    # Si l'IA a encore raté, on force un préfixe par défaut (chore) ou on demande une correction
    echo -e "\n⚠️ Format invalide généré : $clean_msg"
    echo "Essai de correction automatique..."
    final_msg="chore: ${clean_msg#*: }"
    git commit -m "$final_msg"
fi
