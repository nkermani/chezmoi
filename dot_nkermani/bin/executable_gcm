#!/bin/bash
# gcm - Version GitHub Copilot CLI (Optimisée Vitesse)

# 1. Récupération du diff (on reste sur 50 lignes pour la rapidité maximale)
full_diff=$(git diff --cached 2>/dev/null | head -n 50)

if [[ -z "$full_diff" ]]; then
    echo "❌ Aucun changement indexé. Faites 'git add' d'abord."
    exit 1
fi

echo "🚀 Génération via Copilot..."

# 2. Utilisation de l'option -p (Prompt) pour éviter le mode interactif
# On demande un message ultra-court pour gagner du temps de génération
msg=$(copilot --prompt "Write a short conventional commit message (type(scope): description) for these changes: $full_diff. Output ONLY the message, no quotes." 2>/dev/null | tr -d '"')

if [[ -n "$msg" ]]; then
    echo -e "\n📝 Message : $msg"
    git commit -m "$msg"
else
    # Si Copilot échoue, on tente une version encore plus courte
    echo "⚠️  Second essai (version courte)..."
    msg=$(copilot -p "Summarize in 1 sentence for git commit: $full_diff" 2>/dev/null)
    
    if [[ -n "$msg" ]]; then
        git commit -m "$msg"
    else
        echo "❌ Échec de la génération."
        exit 1
    fi
fi
