#!/bin/bash
# gcm - Version Turbo Locale (Ollama)

# 1. Préparation du contexte (très court pour la vitesse)
# On ne prend que les noms de fichiers et les 30 premières lignes
diff_context=$(git diff --cached --stat ; git diff --cached | head -n 30)

if [[ -z "$diff_context" ]]; then
    echo "❌ Aucun changement indexé (staged). Faites 'git add' d'abord."
    exit 1
fi

echo "⚡ Génération..."

# 2. Appel Ollama optimisé
# --format json n'est pas utilisé ici pour rester sur du texte brut plus rapide à parser
# On utilise un "System Prompt" intégré pour tuer le blabla
msg=$(ollama run llama3.2:1b "Summarize this diff as a 1-line conventional commit message (type: description). Rules: No intro, no quotes, no period, no markdown, max 50 chars. Diff: $diff_context" 2>/dev/null | head -n 1 | sed 's/^["'\'']//;s/["'\'']$//' | xargs)

# 3. Validation et Commit
if [[ -n "$msg" && ${#msg} -gt 5 ]]; then
    # Nettoyage final pour enlever les préfixes type "Here is..." si l'IA insiste
    clean_msg=$(echo "$msg" | sed 's/^.*message: //I;s/^.*is: //I')
    
    echo -e "\n📝 $clean_msg"
    git commit -m "$clean_msg"
else
    echo "❌ Échec de la génération (Vérifiez 'ollama serve')."
    exit 1
fi
