#!/bin/bash
# gcm - Version Turbo Locale (Conventional Commits)

# 1. Contexte réduit (30 lignes suffisent pour identifier le type)
diff_context=$(git diff --cached --stat ; git diff --cached | head -n 30)

if [[ -z "$diff_context" ]]; then
    echo "❌ Aucun changement indexé."
    exit 1
fi

echo "⚡ Génération..."

# 2. Le Prompt avec vos 11 TYPES (injecté directement dans Ollama)
# On force l'IA à choisir UNIQUEMENT parmi vos mots-clés
msg=$(ollama run llama3.2:1b "Task: 1-line conventional commit.
TYPES: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
RULES: type(scope): description. Max 50 chars. Imperative mood. No period. No quotes. NO intro.
DIFF: $diff_context" 2>/dev/null | head -n 1 | sed 's/^["'\'']//;s/["'\'']$//' | xargs)

# 3. Nettoyage de sécurité (au cas où l'IA ajoute du blabla au début)
clean_msg=$(echo "$msg" | sed -E 's/^(Here is|Commit|Message|Suggested).*[: ]//I')

if [[ -n "$clean_msg" && "$clean_msg" == *:* ]]; then
    echo -e "\n📝 $clean_msg"
    git commit -m "$clean_msg"
else
    # Si l'IA a raté le format, on affiche quand même pour debug
    if [[ -n "$clean_msg" ]]; then
        echo -e "\n⚠️  Format imprécis : $clean_msg"
        git commit -m "$clean_msg"
    else
        echo "❌ Échec Ollama. Vérifiez 'ollama serve'."
        exit 1
    fi
fi
