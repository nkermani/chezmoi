#!/bin/bash
# gcm
diff_context=$(git diff --cached --stat ; git diff --cached | head -n 30)

if [[ -z "$diff_context" ]]; then
    echo "❌ Aucun changement indexé."
    exit 1
fi

echo "⚡ Génération..."

msg=$(ollama run llama3.2:1b "Context: $diff_context
Task: Write a git commit.
Allowed Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert.
Format: type: description
Constraint: Start with the type. No intro text. Max 100 chars." 2>/dev/null | head -n 1 | tr -d '"`')

if [[ ! "$msg" =~ ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert): ]]; then
    if [[ "$msg" =~ ^(Add|Create|New|Implement) ]]; then TYPE="feat";
    elif [[ "$msg" =~ ^(Fix|Repair|Debug) ]]; then TYPE="fix";
    elif [[ "$msg" =~ ^(Doc|Read|Wiki) ]]; then TYPE="docs";
    elif [[ "$msg" =~ ^(Clean|Update|Refactor) ]]; then TYPE="refactor";
    elif [[ "$msg" =~ ^(Test) ]]; then TYPE="test";
    else TYPE="chore"; fi
    
    clean_desc=$(echo "$msg" | sed -E 's/^(Added|Updated|Fixed|Created|Implement|Improved|Changes|Modified) //I')
    msg="$TYPE: ${clean_desc,,}"
fi

if [[ -n "$msg" ]]; then
    echo -e "\n📝 $msg"
    git commit -m "$msg"
else
    echo "❌ Erreur critique Ollama."
    exit 1
fi
